# ============================================================
# Wanderly -- Required API Keys & Configuration
# ============================================================
# This file lists all API keys and secrets used in the project.
# Since this is an Android/Java project, these values are set
# in different locations rather than a single .env file.
# See the README for detailed setup instructions.
# ============================================================

# -- Google Maps / Places / Distance Matrix --
# Set in: AndroidManifest.xml -> <meta-data android:name="com.google.android.geo.API_KEY">
# Enable: Maps SDK for Android, Places API, Distance Matrix API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# -- OpenAI (AI Travel Chatbot) --
# Set in: App settings dialog at runtime (stored in SharedPreferences)
OPENAI_API_KEY=sk-your_openai_api_key_here

# -- OpenRouteService (Route Directions) --
# Set in: MapActivity.java -> ORS_API_KEY constant
# Get one at: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your_openrouteservice_api_key_here

# -- Cloudinary (Image Uploads for Posts & Profile Pictures) --
# Set in: RegisterActivity.java, EditProfileActivity.java, CreatePostActivity.java
# Get credentials at: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset_here

# -- Firebase --
# Configuration is in: app/google-services.json (download from Firebase Console)
# Enable: Authentication (Email/Password), Cloud Firestore, Firebase Storage
# No explicit key needed here -- google-services.json handles it.
